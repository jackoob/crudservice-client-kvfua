{
  "name": "crudservice-client",
  "version": "2.0.4",
  "private": true,
  "author": "Grappes s.r.o.",
  "description": "Grappes Crud client service for Crudo backend",
  "license": "Commercial-grappes",
  "main": "dist/lib/index.js",
  "module": "dist/es/index.js",
  "files": [
    "css",
    "es",
    "lib"
  ],
  "dependencies": {
    "immer": "^3.2.0",
    "immutable": "^3.8.2",
    "prop-types": "^15.6.0",
    "redux-saga": "^1.0.4",
    "reselect": "^4.0.0",
    "url": "^0.11.0"
  },
  "peerDependencies": {
    "react": "16.8.1",
    "react-dom": "16.8.1"
  },
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "babel-plugin-add-module-exports": "^0.2.1",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.12",
    "babel-preset-env": "^1.6.1",
    "babel-preset-minify": "^0.2.0",
    "babel-watch": "^2.0.7",
    "cross-env": "^5.1.3",
    "eslint": "^6.2.1",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-react": "^7.14.3",
    "expect": "^22.0.3",
    "nwb": "0.18.x",
    "react": "16.8.1",
    "react-dom": "16.8.1"
  },
  "keywords": [
    "react-component"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production npm run build:commonjs && npm run build:es",
    "build:dev": "cross-env NODE_ENV=development npm run build:commonjs:dev",
    "build:commonjs": "cross-env BABEL_ENV=commonjs babel src --out-dir dist/lib",
    "build:commonjs:dev": "cross-env babel src --out-dir dist/lib --watch --source-maps",
    "build:commonjs:watch": "npm run build:commonjs -- --watch",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir dist/es",
    "build:es:dev": "cross-env babel src --out-dir dist/es --watch",
    "build:es:watch": "npm run build:es -- --watch",
    "build-deprecated": "nwb build-react-component",
    "clean": "nwb clean-module && nwb clean-demo",
    "start": "nwb serve-react-demo",
    "test": "nwb test-react",
    "test:coverage": "nwb test-react --coverage",
    "test:watch": "nwb test-react --server"
  }
}
